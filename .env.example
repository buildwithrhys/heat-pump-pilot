# Heat Pump Pilot configuration for running outside Home Assistant (docker compose or a venv).
# Copy to .env (never commit .env). The Home Assistant add-on does not use this file;
# it is configured from the add-on options page instead.
PREDHEAT_DATA_MODE=simulated            # simulated | home_assistant
PREDHEAT_OPERATING_MODE=monitor         # monitor | shadow (balanced/max_savings are Phase 5)
PREDHEAT_CONTROL_ENABLED=false          # must stay false; nothing acts on it before Phase 5
PREDHEAT_DATABASE_URL=sqlite:///./data/predheat.sqlite
PREDHEAT_TIMEZONE=Europe/London
PREDHEAT_LATITUDE=
PREDHEAT_LONGITUDE=

# Home Assistant (long-lived access token, read access is enough). Not needed in the add-on.
PREDHEAT_HA_URL=http://homeassistant.local:8123
PREDHEAT_HA_TOKEN=
PREDHEAT_HA_POLL_SECONDS=300

# Optional direct providers (not used by the PoC yet)
PREDHEAT_OCTOPUS_API_KEY=
PREDHEAT_OCTOPUS_ACCOUNT=
PREDHEAT_OPENWEATHER_API_KEY=
PREDHEAT_SOLCAST_API_KEY=

# Simulation
PREDHEAT_SIM_SEED=42
PREDHEAT_SIM_DAYS=14

PREDHEAT_API_HOST=127.0.0.1
PREDHEAT_API_PORT=8750
