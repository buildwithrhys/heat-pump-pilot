# Heat Pump Pilot configuration for running outside Home Assistant (docker compose or a venv).
# Copy to .env (never commit .env). The Home Assistant add-on does not use this file;
# it is configured from the add-on options page instead.
HEAT_PUMP_PILOT_DATA_MODE=simulated            # simulated | home_assistant
HEAT_PUMP_PILOT_OPERATING_MODE=monitor         # monitor | shadow (balanced/max_savings are Phase 5)
HEAT_PUMP_PILOT_CONTROL_ENABLED=false          # must stay false; nothing acts on it before Phase 5
HEAT_PUMP_PILOT_DATABASE_URL=sqlite:///./data/heat_pump_pilot.sqlite
HEAT_PUMP_PILOT_TIMEZONE=Europe/London
HEAT_PUMP_PILOT_LATITUDE=
HEAT_PUMP_PILOT_LONGITUDE=

# Home Assistant (long-lived access token, read access is enough). Not needed in the add-on.
HEAT_PUMP_PILOT_HA_URL=http://homeassistant.local:8123
HEAT_PUMP_PILOT_HA_TOKEN=
HEAT_PUMP_PILOT_HA_POLL_SECONDS=300

# Optional direct providers (not used by the PoC yet)
HEAT_PUMP_PILOT_OCTOPUS_API_KEY=
HEAT_PUMP_PILOT_OCTOPUS_ACCOUNT=
HEAT_PUMP_PILOT_OPENWEATHER_API_KEY=
HEAT_PUMP_PILOT_SOLCAST_API_KEY=

# Simulation
HEAT_PUMP_PILOT_SIM_SEED=42
HEAT_PUMP_PILOT_SIM_DAYS=14

HEAT_PUMP_PILOT_API_HOST=127.0.0.1
HEAT_PUMP_PILOT_API_PORT=8750
